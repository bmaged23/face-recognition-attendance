# Shared settings: enrollment and recognition must use the same model/collection.
RECOGNITION_FAMILY=adaface
MODEL_NAME=ir_100_webface12m
QDRANT_COLLECTION=people_adaface_ir_100_webface12m
QDRANT_URL=http://localhost:5333
DEVICE=cuda
RECOGNITION_CONFIDENCE=0.4
RECOGNITION_MIN_MARGIN=0.05
SHOW_RECOGNITION_CONFIDENCE=true
# Tracking: 0 uses the refresh setting, positive values override it.
# Without tracking: 0 recognizes every frame, positive values sample in seconds.
SAMPLE_EVERY=0
USE_IOU_TRACKING=true
IOU_THRESHOLD=0.5
RECOGNITION_REFRESH_SECONDS=0.5
DETECTOR_SIZE=640
MAX_IMAGE_BYTES=10485760
# ADAFACE_MODEL_PATH=/absolute/path/to/adaface_ir100_webface12m.ckpt
# INSIGHTFACE_ROOT=/absolute/path/to/insightface/cache
# Optional single-process embedded gallery; overrides QDRANT_URL when set.
# QDRANT_PATH=/absolute/path/to/private/gallery
# Shared inference is serialized; extra queued work is rejected with HTTP 429.
JOB_WORKERS=1
JOB_CAPACITY=4
JOB_HISTORY=128
# AdaFace detector and inference parameters (DETECTOR_SIZE applies to InsightFace).
MTCNN_FINAL_THRESHOLD=0.9
MTCNN_SCALE_FACTOR=0.85
MTCNN_MIN_FACE_SIZE=20
EMBEDDING_BATCH_SIZE=32
INFERENCE_THREADS=2
# Bound uploaded-photo inference resolution; EXIF orientation is applied first.
MAX_IMAGE_DIMENSION=1600
